      "(?i)(token|secret|password|passwd|api[_-]?key|authorization)\\s*[:=]",
      "[A-Za-z0-9_-]{23,28}\\.[A-Za-z0-9_-]{6,7}\\.[A-Za-z0-9_-]{27,}"
