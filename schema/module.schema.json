{
  "$comment": "workflow-board/module/v1. cards.items is injected from board.schema.json by validate.py.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "description",
    "created_at",
    "exposed_ports",
    "cards",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "workflow-board/module/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "origin_board": {
      "type": "string"
    },
    "exposed_ports": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cards": {
      "type": "array"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9_-]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9_-]+$"
          }
        }
      }
    }
  }
}
